#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99

. /lib/functions/gl_util.sh
model=$(get_model)

AGH_RAM_DIR="/tmp/AGH_data"
AGH_INIT_DIR="/tmp/AGH_init"
AGH_PERSIST_DIR="/etc/AdGuardHome"
AGH_CONFIG="$AGH_PERSIST_DIR/config.yaml"
AGH_RELEASE_TAR="AdGuardHome_linux_mipsle_softfloat.tar.gz"
AGH_CHECKSUM_FILE="checksums.txt"
AGH_DOWNLOAD_URL="https://github.com/AdguardTeam/AdGuardHome/releases/latest/download/$AGH_RELEASE_TAR"
AGH_CHECKSUM_URL="https://github.com/AdguardTeam/AdGuardHome/releases/latest/download/$AGH_CHECKSUM_FILE"
AGH_RAM_BIN="$AGH_RAM_DIR/AdGuardHome"

start_service() {
	[ "$(uci -q get adguardhome.config.enabled)" = "1" ] || exit 0

    logger -t AGH-INIT.D "Hello, World! Checking internet connectivity..."
    if ping -c1 github.com >/dev/null 2>&1; then
        logger -t AGH-INIT.D "Internet is available. Proceeding with online update."

        mkdir -p "$AGH_INIT_DIR"
        cd "$AGH_INIT_DIR" || exit 1

        logger -t AGH-INIT.D "Downloading release and checksum..."
        wget -q "$AGH_DOWNLOAD_URL" -O "$AGH_RELEASE_TAR" && \
        wget -q "$AGH_CHECKSUM_URL" -O "$AGH_CHECKSUM_FILE"

        logger -t AGH-INIT.D "Verifying downloaded checksum for $AGH_RELEASE_TAR..."
        # Extract only the relevant checksum line
        CHECK_LINE=$(grep "[[:space:]]\./$AGH_RELEASE_TAR\$" "$AGH_CHECKSUM_FILE")
        echo "$CHECK_LINE" | sha256sum -c - >/dev/null 2>&1 || {
            logger -t AGH-INIT.D "Checksum mismatch. Redownloading..."
            rm -f "$AGH_RELEASE_TAR" "$AGH_CHECKSUM_FILE"
            wget -q "$AGH_DOWNLOAD_URL" -O "$AGH_RELEASE_TAR" && \
            wget -q "$AGH_CHECKSUM_URL" -O "$AGH_CHECKSUM_FILE"
            CHECK_LINE=$(grep "[[:space:]]\./$AGH_RELEASE_TAR\$" "$AGH_CHECKSUM_FILE")
            echo "$CHECK_LINE" | sha256sum -c - >/dev/null 2>&1 || {
                logger -t AGH-INIT.D "Checksum failed again. Aborting."
                exit 1
            }
        }

        logger -t AGH-INIT.D "Checking persistent storage version via checksum..."
        if [ -f "$AGH_PERSIST_DIR/$AGH_RELEASE_TAR" ]; then
            # Use same checksum line to verify persistent copy
            echo "$CHECK_LINE" | sed "s|\./$AGH_RELEASE_TAR|$AGH_PERSIST_DIR/$AGH_RELEASE_TAR|" | sha256sum -c - >/dev/null 2>&1
            MATCH=$?
        else
            MATCH=1
        fi

        if [ $MATCH -eq 0 ]; then
            logger -t AGH-INIT.D "Persistent version matches checksum. Extracting to RAM."
            mkdir -p "$AGH_RAM_DIR"
            tar -xzf "$AGH_RELEASE_TAR" -C "$AGH_RAM_DIR"
        else
            logger -t AGH-INIT.D "Persistent version is outdated or missing. Updating..."
            rm -f "$AGH_PERSIST_DIR/$AGH_RELEASE_TAR"
            cp "$AGH_RELEASE_TAR" "$AGH_PERSIST_DIR/"
            mkdir -p "$AGH_RAM_DIR"
            tar -xzf "$AGH_RELEASE_TAR" -C "$AGH_RAM_DIR"
        fi

        logger -t AGH-INIT.D "Cleaning up temp directory..."
        rm -rf "$AGH_INIT_DIR"
        cp /tmp/AGH_data/AdGuardHome/AdGuardHome /tmp/AGH_data/AGH
        rm -rf /tmp/AGH_data/AdGuardHome
        mv /tmp/AGH_data/AGH /tmp/AGH_data/AdGuardHome
        chmod +x "$AGH_RAM_BIN"
        logger -t AGH-INIT.D "Starting AdGuardHome with updated binary..."
    else
        logger -t AGH-INIT.D "No internet. Using persistent release..."
        mkdir -p "$AGH_RAM_DIR"
        tar -xzf "$AGH_PERSIST_DIR/$AGH_RELEASE_TAR" -C "$AGH_RAM_DIR"
        cp /tmp/AGH_data/AdGuardHome/AdGuardHome /tmp/AGH_data/AGH
        rm -rf /tmp/AGH_data/AdGuardHome
        mv /tmp/AGH_data/AGH /tmp/AGH_data/AdGuardHome
        chmod +x "$AGH_RAM_BIN"
        logger -t AGH-INIT.D "Starting AdGuardHome from persistent copy..."
    fi

    #b1300 dose not support mmap,need link the data to tmp fs
	[ "$model" = "b1300" ] && {
		rm -rf /etc/AdGuardHome/data 2>/dev/null
		mkdir -p /tmp/AGH_data
		ln -s /tmp/AGH_data /etc/AdGuardHome/data
	}

	[ "$(uci -q get adguardhome.config.dns_enabled)" = "1" ] && {
		uci set firewall.adguard_home='redirect'
		uci set firewall.adguard_home.name="Adguard Home"
		uci set firewall.adguard_home.src='lan'
		uci set firewall.adguard_home.src_dport='53'
		uci set firewall.adguard_home.dest='lan'
		uci set firewall.adguard_home.dest_port='3053'
		uci set firewall.adguard_home.proto='tcpudp'

		has_radio="$(get_radio)"
		[ -n "$has_radio" ] && {
			uci set firewall.adguard_home_guest='redirect'
			uci set firewall.adguard_home_guest.name="Adguard Home guest"
			uci set firewall.adguard_home_guest.src='guest'
			uci set firewall.adguard_home_guest.src_dport='53'
			uci set firewall.adguard_home_guest.dest='guest'
			uci set firewall.adguard_home_guest.dest_port='3053'
			uci set firewall.adguard_home_guest.proto='tcpudp'
		}
	}

	uci commit 'firewall'
	/etc/init.d/firewall reload

	procd_open_instance
	procd_set_param respawn
	procd_set_param stderr 1
    procd_set_param command "$AGH_RAM_BIN" --glinet --no-check-update -c "$AGH_CONFIG" -w "$AGH_RAM_DIR" -l syslog
	procd_close_instance
	[ -e /etc/edgerouter.fw ] && /etc/edgerouter.fw loaddns
}

stop_service(){
	uci delete firewall.adguard_home

	has_radio="$(get_radio)"
	[ -n "$has_radio" ] && {
		uci delete firewall.adguard_home_guest
	}

	uci commit 'firewall'
	/etc/init.d/firewall reload
	[ -e /etc/edgerouter.fw ] && /etc/edgerouter.fw loaddns
}
