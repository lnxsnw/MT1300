#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99

. /lib/functions/gl_util.sh
model=$(get_model)

AGH_RAM_DIR="/tmp/AGH_data"
AGH_RAM_BIN="$AGH_RAM_DIR/AdGuardHome"
AGH_LOCAL_DIR="/mnt/sdcard/AdGuardHome"
AGH_LOCAL_BIN="$AGH_LOCAL_DIR/AdGuardHome"
AGH_RELEASE_URL="https://github.com/AdguardTeam/AdGuardHome/releases/latest/download/AdGuardHome_linux_mipsle_softfloat.tar.gz"
AGH_CHECKSUM_URL="https://github.com/AdguardTeam/AdGuardHome/releases/latest/download/checksums.txt"
AGH_TAR="/tmp/AdGuardHome.tar.gz"
AGH_SUM="/tmp/checksums.txt"

cleanup_temp_files() {
    rm -f "$AGH_TAR" "$AGH_SUM"
    logger -t AGH-INIT.D "Temporary files cleaned up"
}

download_and_verify() {
    logger -t AGH-INIT.D "Checking internet connectivity..."
    for i in $(seq 1 10); do
        if ping -c 1 -W 1 9.9.9.9 >/dev/null 2>&1; then
            logger -t AGH-INIT.D "Internet reachable. Downloading files..."
            wget -O "$AGH_TAR" "$AGH_RELEASE_URL" || return 1
            wget -O "$AGH_SUM" "$AGH_CHECKSUM_URL" || return 1

            EXPECTED_HASH=$(grep "AdGuardHome_linux_mipsle_softfloat.tar.gz" "$AGH_SUM" | awk '{print $1}')
            [ -z "$EXPECTED_HASH" ] && return 1

            ACTUAL_HASH=$(sha256sum "$AGH_TAR" | awk '{print $1}')
            [ "$EXPECTED_HASH" != "$ACTUAL_HASH" ] && {
                logger -t AGH-INIT.D "ERROR: Checksum mismatch! Expected: $EXPECTED_HASH, Got: $ACTUAL_HASH"
                cleanup_temp_files
                return 1
            }

            logger -t AGH-INIT.D "Checksum verified. Extracting..."
            mkdir -p "$AGH_RAM_DIR"
            tar -xzf "$AGH_TAR" -C "$AGH_RAM_DIR" --strip-components=1
            chmod +x "$AGH_RAM_BIN"

            # Compare extracted binary hash with local
            NEW_BIN_HASH=$(sha256sum "$AGH_RAM_BIN" | awk '{print $1}')
            [ -f "$AGH_LOCAL_BIN" ] && OLD_BIN_HASH=$(sha256sum "$AGH_LOCAL_BIN" | awk '{print $1}') || OLD_BIN_HASH=""

            if [ "$NEW_BIN_HASH" != "$OLD_BIN_HASH" ]; then
                logger -t AGH-INIT.D "Binary hash differs. Updating local copy..."
                mkdir -p "$AGH_LOCAL_DIR"
                cp "$AGH_RAM_BIN" "$AGH_LOCAL_BIN"
            else
                logger -t AGH-INIT.D "Binary matches existing local copy. No update needed."
            fi
            cleanup_temp_files
            return 0
        fi
        sleep 1
    done

    logger -t AGH-INIT.D "No internet after 10s. Skipping download."
    return 1
}

prepare_agh_from_local() {
    logger -t AGH-INIT.D "WARNING: Falling back to local copy."
    if [ -x "$AGH_LOCAL_BIN" ]; then
        mkdir -p "$AGH_RAM_DIR"
        cp -r "$AGH_LOCAL_DIR"/* "$AGH_RAM_DIR"/
        chmod +x "$AGH_RAM_BIN"
    else
        logger -t AGH-INIT.D "Local AdGuardHome binary not found or not executable!"
        exit 1
    fi
}
start_service() {
	[ "$(uci -q get adguardhome.config.enabled)" = "1" ] || exit 0

	logger -t AGH-INIT.D "Hello World! AGH is enabled."

	if ! download_and_verify; then
    	# If download_and_verify fails (no internet, checksum mismatch, etc.), fall back to local version
    	prepare_agh_from_local
		logger -t AGH-INIT.D "Launching Stale AGH."
	else
    	# If download_and_verify is successful, copy the local config to the extracted directory in RAM
    	[ -f "$AGH_LOCAL_DIR/config.yaml" ] && cp "$AGH_LOCAL_DIR/config.yaml" "$AGH_RAM_DIR/"
		logger -t AGH-INIT.D "Launching Fresh AGH."
    	# Then proceed with running the downloaded binary from /tmp/AGH_data
	fi

	#b1300 dose not support mmap,need link the data to tmp fs
	[ "$model" = "b1300" ] && {
		rm -rf /etc/AdGuardHome/data 2>/dev/null
		mkdir -p /tmp/AGH_data
		ln -s /tmp/AGH_data /etc/AdGuardHome/data
	}

	[ "$(uci -q get adguardhome.config.dns_enabled)" = "1" ] && {
		uci set firewall.adguard_home='redirect'
		uci set firewall.adguard_home.name="Adguard Home"
		uci set firewall.adguard_home.src='lan'
		uci set firewall.adguard_home.src_dport='53'
		uci set firewall.adguard_home.dest='lan'
		uci set firewall.adguard_home.dest_port='3053'
		uci set firewall.adguard_home.proto='tcpudp'

		has_radio="$(get_radio)"
		[ -n "$has_radio" ] && {
			uci set firewall.adguard_home_guest='redirect'
			uci set firewall.adguard_home_guest.name="Adguard Home guest"
			uci set firewall.adguard_home_guest.src='guest'
			uci set firewall.adguard_home_guest.src_dport='53'
			uci set firewall.adguard_home_guest.dest='guest'
			uci set firewall.adguard_home_guest.dest_port='3053'
			uci set firewall.adguard_home_guest.proto='tcpudp'
		}
	}

	uci commit 'firewall'
	/etc/init.d/firewall reload

	procd_open_instance
	procd_set_param respawn
	procd_set_param stderr 1
	procd_set_param command "$AGH_RAM_BIN" --glinet --no-check-update -c "$AGH_RAM_DIR/config.yaml" -w "$AGH_RAM_DIR" -l syslog
	procd_close_instance
	[ -e /etc/edgerouter.fw ] && /etc/edgerouter.fw loaddns
}

stop_service(){
	uci delete firewall.adguard_home

	has_radio="$(get_radio)"
	[ -n "$has_radio" ] && {
		uci delete firewall.adguard_home_guest
	}

	uci commit 'firewall'
	/etc/init.d/firewall reload
	[ -e /etc/edgerouter.fw ] && /etc/edgerouter.fw loaddns
}
